# Environment Configuration Template
# Copy this file to .env and configure with your settings

# Flask Configuration (if needed for backward compatibility)
FLASK_SECRET_KEY=alert-system-development-key

# Email Configuration
EMAIL_ADDRESS=your-gmail@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password

# FastAPI Configuration
DEBUG=True
API_V1_STR=/api/v1

# Database Configuration
DATABASE_URL=sqlite:///./alert_system.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/alert_db
# For MongoDB: MONGODB_URL=mongodb://localhost:27017/alert_db

# Alert Thresholds (in minutes)
WARNING_THRESHOLD=100
FINAL_ALERT_THRESHOLD=120

# ML Model Paths
ML_MODEL_PATH=backend/ml/alert_model.pkl
ML_FEATURES_PATH=backend/ml/feature_names.pkl
ML_TARGET_ENCODER_PATH=backend/ml/target_encoder.pkl
ML_FEATURE_ENCODERS_PATH=backend/ml/feature_encoders.pkl

# CORS Settings
CORS_ORIGINS=["http://localhost", "http://localhost:8000", "http://127.0.0.1:8000"]

# WebSocket Configuration
WEBSOCKET_PING_INTERVAL=30
